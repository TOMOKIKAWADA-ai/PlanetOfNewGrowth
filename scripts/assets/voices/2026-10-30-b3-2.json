  "lines": [
    { "id": "boss_appear_01", "speaker": "tsukimi", "text": "来ました……大きいのが。", "style": "巨大な敵が現れたのを見つけ、息をのんで、緊張した声で小さく仲間に知らせる。", "seeds": [1501, 1502, 1503] },
    { "id": "level_up_01", "speaker": "tsukimi", "text": "まだ、強くなれる。", "style": "力が湧いてくるのを感じて、静かに自分に言い聞かせるように。", "seeds": [1501, 1502, 1503] },
    { "id": "last_minute_01", "speaker": "tsukimi", "text": "あと一分。落ち着いて。", "style": "残り時間を確かめ、焦る気持ちを抑えて、落ち着いた声で仲間と自分に言う。", "seeds": [1501, 1502, 1503] },

    { "id": "boss_appear_01", "speaker": "akame", "text": "大物だ。私が行く。", "style": "巨大な敵が現れたのを見て、迷わず短く低い声で言い切る。", "seeds": [2501, 2502, 2503] },
    { "id": "level_up_01", "speaker": "akame", "text": "体が軽い。", "style": "力が湧いてくるのを感じて、淡々と短くつぶやく。", "seeds": [2501, 2502, 2503] },
    { "id": "last_minute_01", "speaker": "akame", "text": "あと一分。押し切る。", "style": "残り時間を確かめ、静かに気合いを入れて短く言い切る。", "seeds": [2501, 2502, 2503] },

    { "id": "boss_appear_01", "speaker": "kiichigo", "text": "うわ、でっかいの来た！", "style": "巨大な敵が現れたのを見て、驚きつつも軽口をたたくように明るく。", "seeds": [3501, 3502, 3503] },
    { "id": "level_up_01", "speaker": "kiichigo", "text": "いいね、いいね！", "style": "力が湧いてくるのを感じて、楽しそうに弾んだ声で。", "seeds": [3501, 3502, 3503] },
    { "id": "last_minute_01", "speaker": "kiichigo", "text": "ラスト一分、がんばろっ！", "style": "残り時間を確かめ、疲れを笑い飛ばすように元気よく。", "seeds": [3501, 3502, 3503] }
  ]
}
